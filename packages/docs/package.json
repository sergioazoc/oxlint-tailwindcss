{
  "name": "@oxlint-tailwindcss/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -C ../oxlint-tailwindcss build && pnpm generate && vitepress dev .",
    "build": "pnpm -C ../oxlint-tailwindcss build && pnpm generate && vitepress build .",
    "preview": "vitepress preview .",
    "generate": "node --experimental-strip-types scripts/generate-rules.ts && oxfmt --write rules es/rules",
    "test": "vitest run"
  },
  "devDependencies": {
    "oxlint-tailwindcss": "workspace:*",
    "vitepress": "^2.0.0-alpha.20",
    "vitest": "^5.0.1"
  }
}
