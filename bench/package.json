    "@tailwindcss/node": "4.3.3",
    "eslint-plugin-better-tailwindcss": "4.9.0",
    "oxlint": "1.87.0",
    "oxlint-tailwindcss": "1.15.0",
    "shadcn": "4.21.4",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vite-plus": "1.1.0"
  }
}
