{
  "name": "oxlint-tailwindcss-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for oxlint-tailwindcss plugin and its documentation site",
  "homepage": "https://github.com/sergioazoc/oxlint-tailwindcss#readme",
  "bugs": {
    "url": "https://github.com/sergioazoc/oxlint-tailwindcss/issues"
  },
  "license": "MIT",
  "author": "Sergio Azocar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergioazoc/oxlint-tailwindcss.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -C packages/oxlint-tailwindcss build",
    "dev": "pnpm -C packages/oxlint-tailwindcss dev",
    "test": "pnpm -C packages/oxlint-tailwindcss test",
    "test:watch": "pnpm -C packages/oxlint-tailwindcss test:watch",
    "bench": "pnpm -C packages/oxlint-tailwindcss bench",
    "lint": "pnpm -C packages/oxlint-tailwindcss lint",
    "format": "pnpm -C packages/oxlint-tailwindcss format",
    "format:check": "pnpm -C packages/oxlint-tailwindcss format:check",
    "typecheck": "pnpm -C packages/oxlint-tailwindcss typecheck"
  },
  "engines": {
    "node": ">=20"
  }
}
