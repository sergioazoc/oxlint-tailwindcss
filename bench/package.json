  "scripts": {
    "corpus": "node corpus.mjs",
    "test": "node --test 'test/*.test.mjs'"
  },
  "devDependencies": {
    "@shadcn/lint": "0.2.0",
    "@tailwindcss/node": "4.3.3",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "oxlint": "1.85.0",
    "oxlint-tailwindcss": "1.13.0",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  }
}
