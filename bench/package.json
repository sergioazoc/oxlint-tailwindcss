{
  "name": "oxlint-tailwindcss-bench",
  "version": "0.0.0",
  "private": true,
  "description": "Reproducible corpus benchmark for oxlint-tailwindcss. Deliberately outside the pnpm workspace so competitor packages never reach the main lockfile.",
  "type": "module",
  "scripts": {
    "corpus": "node corpus.mjs",
    "test": "node --test 'test/*.test.mjs'"
  },
  "devDependencies": {
    "@shadcn/lint": "0.2.3",
    "@tailwindcss/node": "4.3.3",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "eslint-plugin-tailwindcss": "4.4.0",
    "oxlint": "1.90.0",
    "oxlint-tailwindcss": "1.17.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  }
}
