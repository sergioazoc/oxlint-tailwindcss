{
  "name": "oxlint-tailwindcss-bench",
  "version": "0.0.0",
  "private": true,
  "description": "Reproducible corpus benchmark for oxlint-tailwindcss. Deliberately outside the pnpm workspace so competitor packages never reach the main lockfile.",
